# Database
DB_HOST = your_db_host
DB_PORT = your_db_port
DB_USERNAME = your_db_username
DB_PASSWORD = your_db_password
DB_DATABASE = your_db

# AWS
AWS_REGION = your_aws_region
AWS_ACCESS_KEY_ID = your_aws_access_id
AWS_SECRET_ACCESS_KEY = your_aws_access_key
AWS_S3_BUCKET_NAME = your_aws_bucket_name

# Google OAuth
GOOGLE_CLIENT_ID = your_google_client_id
GOOGLE_CLIENT_SECRET = your_google_client_secret
CALL_BACK_URL = your_callback_url

# JWT
JWT_ACCESS_SECRET = your_jwt_access_secret
JWT_REFRESH_SECRET = your_jwt_refresh_secret
JWT_ACCESS_EXPIRATION = 1d
JWT_REFRESH_EXPIRATION = 7d

# App
URL = your_api_url

# Email
EMAIL_USER = your_email_user
EMAIL_PASS = your_email_passwore

# Toss Payments
TOSS_SECRET_KEY= your_secret_key
TOSS_API_URL = https://api.tosspayments.com/v1/payments

# Local AI Server
AI_SERVER_URL = your_ai_server_url

# DeepL
DEEPL_API_KEY = your_deepl_api_key

# Stability AI
AI_IMAGE_ENGINE_ID = your_ai_image_engine_id
AI_IMAGE_API_HOST = https://api.stability.ai
AI_IMAGE_API_KEY = your_ai_image_api_key
